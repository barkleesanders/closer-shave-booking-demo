{
  "dependencies": {
    "hono": "^4.13.13"
  },
  "description": "Unofficial concept demo: Workers-native barber booking for The Closer Shave (SF). Hono + D1, no build step for the frontend.",
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/node": "^26.6.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "miniflare": "5.20261019.1-beta"
  },
  "name": "closer-shave-booking-demo",
  "private": true,
  "scripts": {
    "deploy": "npm run verify && wrangler deploy -c ./wrangler.toml",
    "dev": "wrangler dev -c ./wrangler.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . --error-on-warnings",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:runtime && npm audit --audit-level=low"
  },
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.22.0"
  }
}
